# Получить у @BotFather. Не коммитить реальный токен.
BOT_TOKEN=123456789:replace-with-real-token

# Пауза между кадрами rich draft, миллисекунды: 0..5000.
STREAM_DELAY_MS=350

# DEBUG, INFO, WARNING, ERROR или CRITICAL.
LOG_LEVEL=INFO

# queue | approve | decline | webapp. Безопасное значение по умолчанию — queue.
JOIN_REQUEST_MODE=queue

# Обязателен только для JOIN_REQUEST_MODE=webapp; Telegram требует HTTPS.
JOIN_REQUEST_WEB_APP_URL=

# Удалять накопленные updates при старте polling.
DROP_PENDING_UPDATES=false

